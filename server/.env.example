# Settings of the rt server (server/src/config.js). Names and meanings only: never put real
# values in this file or anywhere in the repository.
# Production: /etc/jigsaw-rt.env (root:root, mode 600), created from this file by
# scripts/rt/setup.sh with the non-secret production values filled in (docs/ops.md).
# Local development does not use it: `pnpm rt:dev` reads the local Supabase stack.

# "production" on the rt server (test hooks and the dev teacher token route stay off).
NODE_ENV=
# Listen address and port. Production: 127.0.0.1 and 3400 (Caddy proxies rt.gyosil.app here).
HOST=
PORT=
# 1 = take the client address from X-Forwarded-For. Production: 1 (Caddy sets that header and
# ignores the one a client sends, docs/ops.md).
RT_TRUST_PROXY=
# Comma-separated origins allowed for HTTP and sockets. Production: https://jigsaw.gyosil.app
ALLOWED_ORIGINS=
# gyosil Supabase project URL, https://<project ref>.supabase.co (not secret).
SUPABASE_URL=
# Secret. service_role key of the gyosil project (Dashboard > Project Settings > API keys).
SUPABASE_SERVICE_ROLE_KEY=
# Public anon key of the gyosil project, used to check teachers' Google ID tokens.
SUPABASE_ANON_KEY=
# Secret. Signs teacher tokens; 32 characters or more, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
# Google OAuth client ID of the sign-in button (public value).
GOOGLE_CLIENT_ID=

# Optional limits, defaults in server/src/config.js: RT_MAX_CONNECTIONS,
# RT_MAX_CONNECTIONS_PER_IP, RT_MESSAGES_PER_SECOND, RT_HTTP_PER_MINUTE, RT_WRONG_CODE_LIMIT,
# RT_WRONG_CODE_BONUS, RT_WRONG_CODE_WINDOW_MS, RT_WRONG_CODE_BLOCK_MS, RT_MAX_OPEN_SESSIONS,
# RT_MAX_MEMBERS, RT_MAX_OPEN_PER_TEACHER, RT_MAX_IMAGES_PER_TEACHER, RT_UPLOADS_PER_HOUR.
