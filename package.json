{
  "name": "jigsaw",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "assets": "node scripts/assets.mjs",
    "test:db": "vitest run --config vitest.db.config.js",
    "db:start": "npx --yes supabase@2.120.0 start",
    "db:stop": "npx --yes supabase@2.120.0 stop",
    "db:reset": "npx --yes supabase@2.120.0 db reset",
    "db:status": "npx --yes supabase@2.120.0 status -o env",
    "images:builtin": "node scripts/builtin-images.mjs",
    "teacher:open": "node scripts/teacher-open.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@supabase/supabase-js": "2.117.2",
    "jsqr": "1.4.0",
    "pg": "^8.23.1",
    "vitest": "^5.0.3"
  }
}
